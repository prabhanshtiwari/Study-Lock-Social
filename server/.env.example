NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/studylock?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
PUBLIC_APP_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=Study Lock <no-reply@your-verified-domain.example>
# Put the owner's verified account email here BEFORE first registration to grant moderator access.
ADMIN_EMAILS=owner@example.com
# Optional exact additional browser origins, comma-separated without trailing slash.
CORS_ORIGINS=http://localhost:3000
# Allows the extension origin to read API responses. Set false when social sync is unused.
ALLOW_EXTENSION_ORIGINS=true
